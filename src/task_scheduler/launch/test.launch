<launch>

    <!-- ================================================== -->
    <!-- 语音识别 -->
    <!-- ================================================== -->
    <node name="voice_recognition"
          pkg="voice_pkg"
          type="voice_recognition.py"
          output="screen"
          respawn="true"
          respawn_delay="2">

        <param name="device_index" value="-1"/>

        <env name="http_proxy"  value="http://192.168.103.101:7890"/>
        <env name="https_proxy" value="http://192.168.103.101:7890"/>
        <env name="HTTP_PROXY"  value="http://192.168.103.101:7890"/>
        <env name="HTTPS_PROXY" value="http://192.168.103.101:7890"/>

        <env name="no_proxy"  value="localhost,127.0.0.1,::1"/>
        <env name="NO_PROXY" value="localhost,127.0.0.1,::1"/>

        <env name="ALL_PROXY" value=""/>
        <env name="all_proxy" value=""/>
        <env name="ftp_proxy" value=""/>
        <env name="FTP_PROXY" value=""/>

    </node>

    <!-- 人脸唤醒 -->
    <node name="face_node"
          pkg="yolo_face"
          type="face_node.py"
          output="screen"
          respawn="true"
          respawn_delay="2"/>

    <!-- /nav_goal -> move_base -->
    <node name="nav_goal_node"
          pkg="reicoures_nav"
          type="nav_goal_node"
          output="screen"
          respawn="true"
          respawn_delay="2"/>

    <!-- ================================================== -->
    <!-- 充电所需服务 -->
    <!-- ================================================== -->
    <include file="$(find relative_move)/launch/relative_move.launch"/>
    <include file="$(find ar_pose)/launch/ar_base_sim.launch"/>

    <!-- 自动充电控制节点 -->
    <node name="auto_charge_node"
          pkg="reicoures_relocalization"
          type="auto_charge_node"
          output="screen"
          respawn="true"
          respawn_delay="2"/>

    <!-- ================================================== -->
    <!-- 任务三目标检测（找手机/书包） -->
    <!-- ================================================== -->
    <node name="task3_detector"
          pkg="task3_vision"
          type="task3_detector.py"
          output="screen"
          respawn="true"
          respawn_delay="2">

        <param name="model_path"
               value="/home/reicom2025/bobac3_ws/src/model/best.pt"/>

        <param name="image_topic"
               value="/berxel_base/color/image_raw"/>

        <param name="conf" value="0.25"/>
        <param name="imgsz" value="640"/>
        <param name="max_fps" value="10.0"/>
        <param name="detect_seconds" value="1.5"/>
        <param name="min_hit_frames" value="3"/>
        <param name="show_window" value="true"/>

    </node>

    <!-- ================================================== -->
    <!-- 任务二食材识别（推荐菜） -->
    <!-- ================================================== -->
    <node name="task2_detector"
          pkg="task_scheduler"                         
          type="task2_detector.py"
          output="screen"
          respawn="true"
          respawn_delay="2">

        <param name="model_path"
               value="/home/reicom2025/bobac3_ws/src/model/best.pt"/>

        <param name="image_topic"
               value="/berxel_base/color/image_raw"/>

        <param name="conf" value="0.25"/>
        <param name="imgsz" value="640"/>
        <param name="max_fps" value="10.0"/>
        <param name="detect_seconds" value="1.5"/>
        <param name="min_hit_frames" value="3"/>
        <param name="show_window" value="true"/>

    </node>

    <!-- ================================================== -->
    <!-- 任务调度器（放最后启动） -->
    <!-- ================================================== -->
    <node name="task_scheduler_node"
          pkg="task_scheduler"
          type="task_scheduler_node"
          output="screen"
          respawn="true"
          respawn_delay="2"/>

</launch>