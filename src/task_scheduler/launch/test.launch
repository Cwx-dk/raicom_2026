<launch>

    <!-- ================================================== -->
    <!-- 语音识别 -->
    <!-- ================================================== -->
    <node name="voice_recognition"
          pkg="voice_pkg"
          type="voice_recognition.py"
          output="screen"
          respawn="true"
          respawn_delay="2">

        <param name="device_index"
               value="-1"/>

        <env name="http_proxy"
             value="http://192.168.103.101:7890"/>

        <env name="https_proxy"
             value="http://192.168.103.101:7890"/>

        <env name="HTTP_PROXY"
             value="http://192.168.103.101:7890"/>

        <env name="HTTPS_PROXY"
             value="http://192.168.103.101:7890"/>

        <env name="no_proxy"
             value="localhost,127.0.0.1,::1"/>

        <env name="NO_PROXY"
             value="localhost,127.0.0.1,::1"/>

        <env name="ALL_PROXY"
             value=""/>

        <env name="all_proxy"
             value=""/>

        <env name="ftp_proxy"
             value=""/>

        <env name="FTP_PROXY"
             value=""/>

    </node>


    <!-- ================================================== -->
    <!-- 人脸现实摄像头 -->
    <!--
         使用原来第一台现实摄像头。
         /face_detection_enable 只控制人脸识别算法开关。
         即使算法 OFF，摄像头画面仍一直实时显示。
    -->
    <!-- ================================================== -->
    <node name="face_node"
          pkg="yolo_face"
          type="face_node.py"
          output="screen"
          respawn="true"
          respawn_delay="2">

        <param name="camera_index"
               value="0"/>

    </node>


    <!-- ================================================== -->
    <!-- 导航 -->
    <!-- ================================================== -->
    <node name="nav_goal_node"
          pkg="reicoures_nav"
          type="nav_goal_node"
          output="screen"
          respawn="true"
          respawn_delay="2"/>


    <!-- ================================================== -->
    <!-- 充电 -->
    <!-- ================================================== -->
    <include file="$(find relative_move)/launch/relative_move.launch"/>

    <include file="$(find ar_pose)/launch/ar_base_sim.launch"/>


    <node name="auto_charge_node"
          pkg="reicoures_relocalization"
          type="auto_charge_node"
          output="screen"
          respawn="true"
          respawn_delay="2"/>


    <!-- ================================================== -->
    <!-- 任务二：第二台独立现实摄像头 + best2.pt -->
    <!--
         第一台现实摄像头：
             人脸识别，原设备组 /dev/video0~3

         第二台现实摄像头：
             食材识别，插入后新增 /dev/video4 和 /dev/video5

         task2_food_detector 只检查 /dev/video4、/dev/video5，
         不碰人脸摄像头。
         食材摄像头也始终保持实时画面；
         /task2_detection_enable 只控制 YOLO 是否运行。
    -->
    <!-- ================================================== -->
    <node name="task2_food_detector"
          pkg="task_scheduler"
          type="task2_food_detector.py"
          output="screen"
          respawn="true"
          respawn_delay="2">

        <param name="model_path"
               value="/home/reicom2025/bobac3_ws/src/model/best2.pt"/>

        <param name="recipes_path"
               value="/home/reicom2025/bobac3_ws/src/task_scheduler/src/recipes.json"/>

        <rosparam param="camera_devices">
          ["/dev/video4", "/dev/video5"]
        </rosparam>

        <param name="conf"
               value="0.25"/>

        <param name="imgsz"
               value="640"/>

        <param name="show_window"
               value="true"/>

        <param name="camera_width"
               value="640"/>

        <param name="camera_height"
               value="480"/>

        <param name="camera_fps"
               value="30"/>

    </node>


    <!-- ================================================== -->
    <!-- 任务三：Gazebo 官方 top_camera -->
    <!-- ================================================== -->
    <node name="task3_detector"
          pkg="task3_vision"
          type="task3_detector.py"
          output="screen"
          respawn="true"
          respawn_delay="2">

        <param name="model_path"
               value="/home/reicom2025/bobac3_ws/src/model/best.pt"/>

        <param name="image_topic"
               value="/top_camera/image_raw"/>

        <param name="conf"
               value="0.25"/>

        <param name="imgsz"
               value="640"/>

        <param name="max_fps"
               value="10.0"/>

        <param name="detect_seconds"
               value="1.5"/>

        <param name="min_hit_frames"
               value="3"/>

        <param name="internal_timeout"
               value="8.0"/>

        <param name="show_window"
               value="true"/>

    </node>


    <!-- ================================================== -->
    <!-- 调度器最后启动 -->
    <!-- ================================================== -->
    <node name="task_scheduler_node"
          pkg="task_scheduler"
          type="task_scheduler_node"
          output="screen"
          respawn="true"
          respawn_delay="2">

        <param name="dwa_namespace"
               value="/move_base_node/DWAPlannerROS"/>

    </node>

</launch>
